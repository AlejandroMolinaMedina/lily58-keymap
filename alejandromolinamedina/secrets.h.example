// Copia este archivo como secrets.h en la misma carpeta y pon tus valores.
// secrets.h esta en .gitignore a proposito: nunca se sube al repositorio.
//
//   cp alejandromolinamedina/secrets.h.example alejandromolinamedina/secrets.h
//
// Los ocho defines son obligatorios. Si falta alguno, la compilacion falla con
// "error: 'SECRETx' undeclared (first use in this function)".

// Cadenas sueltas, en la fila de numeros de la capa 2.
#define SECRET  "texto A"
#define SECRET1 "texto B"
#define SECRET2 "texto C"
#define SECRET3 "texto D"

// Atajos de correo. El keymap escribe USER, luego la arroba, luego DOMAIN,
// asi que el usuario y el dominio van separados y SIN la @.
#define SECRET4_USER   "usuario1"
#define SECRET4_DOMAIN "ejemplo.com"
#define SECRET5_USER   "usuario2"
#define SECRET5_DOMAIN "ejemplo.com"
